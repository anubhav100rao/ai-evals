# Which provider the agent + judges use: openrouter | librechat  (override per run with --provider)
LLM_PROVIDER=openrouter

# OpenRouter: native tool calling + structured outputs
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-6.2-sol
OPENROUTER_JUDGE_MODEL=openai/gpt-6.2-sol

# LibreChat agent endpoint (fallback; no native tools -> JSON action protocol)
LIBRECHAT_BASE_URL=https://chat-dev.acciojobs.com/api/agents/v1
LIBRECHAT_API_KEY=your-key-here
LIBRECHAT_MODEL=agent__d2PA6a4YSYjSN1SzzbRl

# Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_BASE_URL=http://localhost:6006
